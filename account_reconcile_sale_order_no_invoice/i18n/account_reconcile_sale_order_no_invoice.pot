#. module: account_reconcile_sale_order_no_invoice
#: model:mail.template,body_html:account_reconcile_sale_order_no_invoice.sale_order_paid_mail_template
msgid ""
"<div style=\"margin: 0px; padding: 0px\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px\">\n"
"                    Hello,\n"
"                    <br/>\n"
"                    <br/>\n"
"                    The sale order <b t-out=\"object.name\"/> has been marked as\n"
"                    paid during a bank reconciliation.\n"
"                    <t t-set=\"statement_line\" t-value=\"ctx.get('sale_order_paid_statement_line')\"/>\n"
"                    <t t-if=\"statement_line\">\n"
"                        The payment has been registered from the bank\n"
"                        transaction \"<t t-out=\"ctx.get('sale_order_paid_reference')\"/>\" of <t t-out=\"format_date(statement_line.date)\"/>\n"
"                        (amount <t t-out=\"format_amount(statement_line.amount, statement_line.currency_id)\"/>).\n"
"                    </t>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    The payment will be reconciled with the invoice once the\n"
"                    sale order is invoiced.\n"
"                    <br/>\n"
"                    <br/>\n"
"                    <a t-attf-href=\"{{object.get_base_url()}}/odoo/orders/{{object.id}}\" target=\"_blank\">Sale order</a>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: account_reconcile_sale_order_no_invoice
#: model:ir.model,name:account_reconcile_sale_order_no_invoice.model_account_bank_statement_line
