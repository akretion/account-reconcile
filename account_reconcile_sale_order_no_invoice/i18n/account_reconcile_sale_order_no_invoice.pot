#. module: account_reconcile_sale_order_no_invoice
#. odoo-python
#: code:addons/account_reconcile_sale_order_no_invoice/models/account_bank_statement_line.py:0
msgid ""
"<p>The sale order <b>%(order)s</b> has been marked as paid during the bank "
"reconciliation of the statement line <a "
"href='/web#model=account.bank.statement.line&amp;id=%(line_id)s'>%(line_name)s</a>"
" of %(date)s (amount %(amount)s).</p><p>The payment is still to be "
"reconciled with the invoice once the sale order is invoiced.</p>"
msgstr ""

#. module: account_reconcile_sale_order_no_invoice
