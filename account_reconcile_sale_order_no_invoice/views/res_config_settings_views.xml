<odoo>
    <record
        id="res_config_settings_view_form_sale_order_payment_reconcile"
        model="ir.ui.view"
    >
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="pay_invoice_online_setting_container" position="after">
                <block
                    title="Sale Orders"
                    id="sale_order_payment_reconcile_setting_container"
                >
                    <setting
                        id="account_reconcile_sale_order_mode_setting"
                        string="Reconcile sale orders"
                        company_dependent="1"
                        help="Behaviour when a bank statement line is reconciled against a sale order (chosen in the &quot;Sales orders&quot; tab of the reconciliation widget or matched by a sale order reconciliation rule): either register the payment on the order without invoicing it, or invoice the order at reconciliation (OCA account_reconcile_sale_order behaviour)."
                    >
                        <field
                            name="account_reconcile_sale_order_mode"
                            options="{'horizontal': true}"
                            widget="radio"
                        />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
