#. module: account_reconcile_sale_order
#: model:ir.model.fields,help:account_reconcile_sale_order.field_account_reconcile_model__sale_order_matching_token_length
msgid "Set the minimum word length to search for. If you set this to 4, and the statement line's label is 'hello you', it will only search for 'hello', not for 'you'"
msgstr "Indiquez la longueur minimale des mots à rechercher. Si vous mettez 4 et que le libellé de la ligne de relevé est « hello you », seuls « hello » sera recherché, pas « you »."

#. module: account_reconcile_sale_order
#: model:ir.model.fields,help:account_reconcile_sale_order.field_account_reconcile_model__sale_order_matching_payment_method_ids
msgid "Set this field to restrict sales order matching to specific payment methods used on the SO's payment transaction"
msgstr "Renseignez ce champ pour restreindre le rapprochement des commandes clients à certains modes de paiement utilisés sur la transaction de paiement de la commande."

