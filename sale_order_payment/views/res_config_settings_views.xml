<odoo>
    <record id="res_config_settings_view_form_sale_order_payment" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="pay_invoice_online_setting_container" position="after">
                <block
                    title="Sale Order Payments"
                    id="sale_order_payment_link_setting_container"
                >
                    <setting
                        id="sale_order_payment_writeoff_account_id_setting"
                        string="Write-off of the sale order payment differences"
                        company_dependent="1"
                        help="When the payments registered on a sale order don't match exactly the amount of the invoice generated from this order, the difference is written off on this account, as long as it doesn't exceed the maximum amount. Leave the account empty to always reconcile the invoices manually."
                    >
                        <field
                            name="sale_order_payment_writeoff_account_id"
                            class="oe_inline"
                            options="{'no_create': True}"
                        />
                        <label
                            for="sale_order_payment_writeoff_max_amount"
                            string="Maximum difference"
                            class="ms-2"
                        />
                        <field
                            name="sale_order_payment_writeoff_max_amount"
                            class="oe_inline"
                        />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
