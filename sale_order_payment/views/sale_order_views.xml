<odoo>
    <record id="view_order_form_sale_order_payment" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_payment_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="payment_line_count == 0"
                >
                    <field
                        name="payment_line_count"
                        widget="statinfo"
                        string="Payment Entries"
                    />
                </button>
            </xpath>
            <xpath
                expr="//group[@name='sale_total']/field[@name='tax_totals']"
                position="after"
            >
                <div
                    class="d-flex justify-content-end border-top pt-1"
                    invisible="is_paid or (invoice_ids and not payment_line_count)"
                >
                    <span class="o_form_label text-danger">Paid</span>
                    <field
                        name="paid_amount"
                        nolabel="1"
                        widget="monetary"
                        class="fw-bolder text-danger"
                    />
                </div>
                <div
                    class="d-flex justify-content-end border-top pt-1"
                    invisible="not is_paid or (invoice_ids and not payment_line_count)"
                >
                    <span class="o_form_label text-success">Paid</span>
                    <field
                        name="paid_amount"
                        nolabel="1"
                        widget="monetary"
                        class="fw-bolder text-success"
                    />
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_sale_order_payment" model="ir.ui.view">
        <field name="name">sale.order.list.select.sale.order.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <filter name="activities_overdue" position="before">
                <separator />
                <filter
                    name="is_paid"
                    string="Paid"
                    domain="[('is_paid', '=', True)]"
                />
            </filter>
        </field>
    </record>
</odoo>
