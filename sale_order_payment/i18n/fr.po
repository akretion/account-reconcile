#. module: sale_order_payment
#: model_terms:ir.ui.view,arch_db:sale_order_payment.view_order_form_sale_order_payment
msgid "<span class=\"o_form_label text-danger\">To pay</span>"
msgstr "<span class=\"o_form_label text-danger\">À payer</span>"

#. module: sale_order_payment
#: model_terms:ir.ui.view,arch_db:sale_order_payment.view_order_form_sale_order_payment
msgid "<span class=\"o_form_label text-success\">Paid</span>"
