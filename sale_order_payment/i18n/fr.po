#: model:ir.model.fields,field_description:sale_order_payment.field_sale_order__amount_due
msgid "Amount Due"
msgstr "Montant dû"

#. module: sale_order_payment
#: model:ir.model,name:sale_order_payment.model_res_company
msgid "Companies"
msgstr "Sociétés"

#. module: sale_order_payment
#: model:ir.model,name:sale_order_payment.model_res_config_settings
msgid "Config Settings"
msgstr "Paramètres de configuration"

#. module: sale_order_payment
#: model:ir.model,name:sale_order_payment.model_account_move
msgid "Journal Entry"
msgstr "Pièce comptable"

#. module: sale_order_payment
#: model:ir.model,name:sale_order_payment.model_account_move_line
msgid "Journal Item"
msgstr "Écriture comptable"

#. module: sale_order_payment
#: model:ir.model.fields,help:sale_order_payment.field_sale_order__payment_line_ids
msgid "Journal items of the payment entries linked to this sale order. Typically the receivable counterpart items created when the customer payment is reconciled against the order."
msgstr "Écritures comptables des règlements liés à cette commande client. Il s'agit en général des lignes de contrepartie du compte client créées lors du rapprochement du paiement client avec la commande."

#. module: sale_order_payment
#: model:ir.model.fields,field_description:sale_order_payment.field_res_company__sale_order_payment_writeoff_max_amount
#: model:ir.model.fields,field_description:sale_order_payment.field_res_config_settings__sale_order_payment_writeoff_max_amount
msgid "Max Sale Order Payment Write-off Amount"
msgstr "Montant maximal d'annulation des paiements de commande"

#. module: sale_order_payment
#: model_terms:ir.ui.view,arch_db:sale_order_payment.res_config_settings_view_form_sale_order_payment
msgid "Maximum difference"
msgstr "Écart maximum"

#. module: sale_order_payment
#: model:ir.model.fields,help:sale_order_payment.field_res_company__sale_order_payment_writeoff_max_amount
#: model:ir.model.fields,help:sale_order_payment.field_res_config_settings__sale_order_payment_writeoff_max_amount
msgid "Maximum difference, in the company currency, that can be written off automatically when reconciling the payments of a sale order with the invoice generated from this order. Above this amount, the reconciliation is left to the accountant."
msgstr "Écart maximal, dans la devise de la société, pouvant être annulé automatiquement lors du rapprochement des paiements d'une commande client avec la facture générée depuis cette commande. Au-delà de ce montant, le rapprochement est laissé au comptable."

#. module: sale_order_payment
#: model:ir.model.fields,field_description:sale_order_payment.field_sale_order__is_paid
msgid "Paid"
msgstr "Payé"

#. module: sale_order_payment
#: model:ir.model.fields,field_description:sale_order_payment.field_sale_order__paid_amount
