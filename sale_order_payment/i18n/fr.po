msgstr "Annulation du règlement sur %(invoice)s (%(order)s)"

#. module: sale_order_payment
#: model:ir.model.fields,help:sale_order_payment.field_sale_order__amount_due
msgid "Remaining amount to pay on this sale order."
msgstr "Montant restant à payer sur cette commande client."

#. module: sale_order_payment
#: model:ir.model.fields,field_description:sale_order_payment.field_account_move_line__sale_order_id
msgid "Sale Order"
msgstr "Commande client"

#. module: sale_order_payment
#: model:ir.model.fields,field_description:sale_order_payment.field_res_company__sale_order_payment_writeoff_account_id
#: model:ir.model.fields,field_description:sale_order_payment.field_res_config_settings__sale_order_payment_writeoff_account_id
msgid "Sale Order Payment Write-off Account"
msgstr "Compte d'annulation des paiements de commande"

#. module: sale_order_payment
#: model_terms:ir.ui.view,arch_db:sale_order_payment.res_config_settings_view_form_sale_order_payment
msgid "Sale Order Payments"
msgstr "Règlements des commandes clients"

#. module: sale_order_payment
#: model:ir.model,name:sale_order_payment.model_sale_order
msgid "Sales Order"
msgstr "Commande client"

#. module: sale_order_payment
#. odoo-python
#: code:addons/sale_order_payment/models/account_move.py:0
msgid "The payments registered on the sale order %(order)s couldn't be reconciled automatically with this invoice: the difference between the invoice and the payments is %(difference)s. Please reconcile this invoice manually."
msgstr "Les paiements enregistrés sur la commande client %(order)s n'ont pas pu être rapprochés automatiquement avec cette facture : la différence entre la facture et les paiements est de %(difference)s. Veuillez rapprocher cette facture manuellement."

#. module: sale_order_payment
#: model:ir.model.fields,help:sale_order_payment.field_sale_order__paid_amount
msgid "Total amount of the payment journal items linked to this sale order (posted or draft entries, cancelled entries excluded)."
msgstr "Montant total des écritures de règlement liées à cette commande client (pièces comptabilisées ou brouillon, pièces annulées exclues)."

#. module: sale_order_payment
#: model:ir.model.fields,help:sale_order_payment.field_sale_order__is_paid
msgid "True when the paid amount covers the total amount of the sale order."
msgstr "Vrai lorsque le montant payé couvre le montant total de la commande client."

#. module: sale_order_payment
#: model_terms:ir.ui.view,arch_db:sale_order_payment.res_config_settings_view_form_sale_order_payment
msgid "When the payments registered on a sale order don't match exactly the amount of the invoice generated from this order, the difference is written off on this account, as long as it doesn't exceed the maximum amount. Leave the account empty to always reconcile the invoices manually."
msgstr "Lorsque les paiements enregistrés sur une commande client ne correspondent pas exactement au montant de la facture générée depuis cette commande, la différence est annulée sur ce compte, tant qu'elle ne dépasse pas le montant maximum. Laissez le compte vide pour toujours rapprocher les factures manuellement."

#. module: sale_order_payment
#: model_terms:ir.ui.view,arch_db:sale_order_payment.res_config_settings_view_form_sale_order_payment
msgid "Write-off of the sale order payment differences"
msgstr "Annulation des écarts de paiement des commandes clients"

#. module: sale_order_payment
#. odoo-python
#: code:addons/sale_order_payment/models/account_move.py:0
msgid "Write-off on %(order)s"
msgstr "Annulation sur %(order)s"

