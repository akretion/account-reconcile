#. module: sale_order_payment
#: model:ir.model.fields,field_description:sale_order_payment.field_account_bank_statement_line__journal_type
#: model:ir.model.fields,field_description:sale_order_payment.field_account_move__journal_type
msgid "Type"
msgstr "Type"

#. module: sale_order_payment
#: model:ir.model.fields,help:sale_order_payment.field_account_bank_statement_line__journal_type
#: model:ir.model.fields,help:sale_order_payment.field_account_move__journal_type
msgid ""
"\n"
"        Select 'Sale' for customer invoices journals.\n"
"        Select 'Purchase' for vendor bills journals.\n"
"        Select 'Cash', 'Bank' or 'Credit Card' for journals that are used in customer or vendor payments.\n"
"        Select 'General' for miscellaneous operations journals.\n"
"        "
msgstr ""
"\n"
"        Sélectionnez 'Vente' pour les journaux des factures clients.\n"
"        Sélectionnez 'Achat' pour les journaux des factures fournisseurs.\n"
"        Sélectionnez 'Espèces', 'Banque' ou 'Carte de crédit' pour les journaux utilisés dans les paiements clients ou fournisseurs.\n"
"        Sélectionnez 'Divers' pour les journaux d'opérations diverses.\n"
"        "

#. module: sale_order_payment
#: model:ir.model.fields,help:sale_order_payment.field_sale_order__has_unallocated_payment
msgid ""
"True when a customer payment of the sale order is not reconciled with an "
"invoice of the order."
msgstr ""
"Vrai lorsqu'un paiement client de la commande client n'est pas lettré avec une facture de la commande."

#. module: sale_order_payment
#: model:ir.model.fields,help:sale_order_payment.field_sale_order__has_unallocated_refund
msgid ""
"True when a refund of the sale order is not reconciled with a credit note of"
" the order."
msgstr ""
"Vrai lorsqu'un remboursement de la commande client n'est pas lettré avec un avoir de la commande."

#. module: sale_order_payment
#: model:ir.model.fields,field_description:sale_order_payment.field_sale_order__has_unallocated_payment
#: model_terms:ir.ui.view,arch_db:sale_order_payment.view_sales_order_filter_sale_order_payment
msgid "Unallocated Payment"
msgstr ""
"Paiement non affecté"

#. module: sale_order_payment
#: model:ir.model.fields,field_description:sale_order_payment.field_sale_order__has_unallocated_refund
#: model_terms:ir.ui.view,arch_db:sale_order_payment.view_sales_order_filter_sale_order_payment
msgid "Unallocated Refund"
msgstr ""
"Remboursement non affecté"

